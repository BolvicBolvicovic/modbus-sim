# Doxygen configuration for the mogbus sources. `make docs` writes XML (the data tools/docs/build.py
# renders the site from) to build/docs/xml and the source browser to build/docs/internals; warnings are
# errors so the comment style stays valid.
PROJECT_NAME           = mogbus
PROJECT_BRIEF          = Modbus device simulator
PROJECT_LOGO           = docs/assets/mogbus-logo.svg
OUTPUT_DIRECTORY       = build/docs
INPUT                  = README.md CONTRIBUTING.md SECURITY.md NOTICE.md AGENTS.md docs/user docs/dev include src examples tests/fuzz
FILE_PATTERNS          = *.c *.h *.md
# Example READMEs are not site pages (older Doxygen also takes any README.md as a main page).
EXCLUDE_PATTERNS       = */examples/*/README.md
IMAGE_PATH             = docs/assets
USE_MDFILE_AS_MAINPAGE = README.md
RECURSIVE              = YES
OPTIMIZE_OUTPUT_FOR_C  = YES
EXTRACT_ALL            = NO
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
TYPEDEF_HIDES_STRUCT   = NO
MARKDOWN_SUPPORT       = YES
MARKDOWN_ID_STYLE      = GITHUB
AUTOLINK_SUPPORT       = NO
JAVADOC_AUTOBRIEF      = NO
GENERATE_LATEX         = NO
GENERATE_HTML          = YES
HTML_OUTPUT            = internals
GENERATE_XML           = YES
XML_OUTPUT             = xml
XML_PROGRAMLISTING     = NO
SOURCE_BROWSER         = NO
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = MOGBUS_API= WITH_TLS=1 WITH_CONFIG=1 "__attribute__(x)="
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = NO
WARN_AS_ERROR          = FAIL_ON_WARNINGS
WARN_FORMAT            = "$file:$line: $text"
HAVE_DOT               = NO
CLASS_GRAPH            = NO
COLLABORATION_GRAPH    = NO
INCLUDE_GRAPH          = NO
INCLUDED_BY_GRAPH      = NO

# Theme: doxygen-awesome-css (vendored in third_party/doxygen-awesome-css), sidebar-only variant
# with the dark-mode toggle, copy buttons on code and links on paragraphs. The header is the
# stock one of `doxygen -w html` plus the script includes at the end of <head>.
HTML_HEADER            = docs/doxygen/header.html
HTML_EXTRA_STYLESHEET  = third_party/doxygen-awesome-css/doxygen-awesome.css \
                         third_party/doxygen-awesome-css/doxygen-awesome-sidebar-only.css \
                         third_party/doxygen-awesome-css/doxygen-awesome-sidebar-only-darkmode-toggle.css
HTML_EXTRA_FILES       = docs/assets/mogbus-logo.svg \
                         third_party/doxygen-awesome-css/doxygen-awesome-darkmode-toggle.js \
                         third_party/doxygen-awesome-css/doxygen-awesome-fragment-copy-button.js \
                         third_party/doxygen-awesome-css/doxygen-awesome-paragraph-link.js
HTML_COLORSTYLE        = LIGHT
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO
